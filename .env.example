# These settings belong ONLY on the backend host (Render / Railway "Environment"
# page). For local development copy this file to .env. Never commit real values
# and never put any of them in public/ or in frontend hosting settings.

# --- Required ---
# Password for the owner-only page at /admin (any username). Use a long one.
ADMIN_PASSWORD=

# Public address of the backend, no trailing slash.
PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# --- Only if the frontend is hosted on a different address (Netlify / Vercel) ---
# The exact frontend address(es) allowed to call the API, comma separated.
FRONTEND_ORIGIN=

# --- Data mode ---
# 1 = real data one trading day late (default; needs no Upstox login).
# 0 = real time (needs the Upstox settings below and a daily sign-in at /admin).
BULLSY_DATA_DELAY_DAYS=1

# --- Which data provider ---
# upstox (default) or angelone
MARKET_DATA_PROVIDER=upstox

# --- Angel One SmartAPI (only when MARKET_DATA_PROVIDER=angelone) ---
# The server signs in by itself with these. Together they are a full login to the
# Angel One account, so enter them ONLY in the host's Environment page.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
# The key shown under the QR code when you enable TOTP (not the 6-digit code).
ANGEL_TOTP_SECRET=
# Optional: override an index token, as EXCHANGE|TOKEN
# ANGEL_TOKEN_NIFTYIT=NSE|99926008

# --- Upstox (needed only for real time) ---
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
# Optional: paste a token generated today instead of signing in at /admin.
UPSTOX_ACCESS_TOKEN=
# Optional: defaults to PUBLIC_BACKEND_URL + /admin/upstox/callback
# UPSTOX_REDIRECT_URI=
# Optional: where to keep the daily token (point at a persistent disk if you have one).
# TOKEN_FILE=/var/data/upstox-token.json

# --- Optional: AI Coach ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional tuning ---
# BULLSY_USE_WEBSOCKET=true
# BULLSY_POLL_INTERVAL_MS=5000
# COACH_LIMIT_PER_IP_PER_HOUR=5
# COACH_LIMIT_PER_DAY=300
# UPSTOX_KEY_NIFTYIT=NSE_INDEX|Nifty IT
